# Local (Docker Compose Postgres)
DATABASE_URL="postgresql://ickoa:ickoa@localhost:5432/ickoa"

NEXT_PUBLIC_SITE_URL="http://localhost:3700"

# Auth.js
AUTH_SECRET="change-me-in-production-use-openssl-rand-base64-32"
AUTH_URL="http://localhost:3700"

# OAuth (optional — configure to enable)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Local disk uploads (default: ./public). On Railway set to volume mount path.
# UPLOAD_ROOT="/data"

# AWS S3 (optional — falls back to local / volume disk)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET=""

# Firebase (optional — push notifications)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Razorpay (후원하기 결제)
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
